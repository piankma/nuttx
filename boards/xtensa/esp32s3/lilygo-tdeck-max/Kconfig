#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_BOARD_LILYGO_TDECK_MAX

config LILYGO_TDECK_MAX_XL9555_FREQUENCY
	int "XL9555 I2C frequency (Hz)"
	default 400000
	depends on IOEXPANDER_PCA9555
	---help---
		I2C bus frequency used to talk to the XL9555 I/O expander, which
		gates the power of most peripherals on the T-Deck Max.

config LILYGO_TDECK_MAX_TCA8418_FREQUENCY
	int "TCA8418 I2C frequency (Hz)"
	default 400000
	depends on INPUT_TCA8418
	---help---
		I2C bus frequency used to talk to the TCA8418, the scanner behind
		the T-Deck Max keyboard.

config LILYGO_TDECK_MAX_BATTERY_CAPACITY
	int "Battery design capacity (mAh)"
	default 1400
	range 0 32767
	depends on BQ27220
	---help---
		The capacity of the cell, which the BQ27220 fuel gauge needs to
		turn charge into a percentage.  The T-Deck Max ships with a
		1400 mAh cell.  The gauge keeps the value in RAM for as long as
		the cell powers it, so it is written at boot only when it differs,
		which takes a couple of seconds.  0 leaves the gauge alone.

config LILYGO_TDECK_MAX_CHARGE_VOLTAGE
	int "Battery charge voltage (mV)"
	default 4288
	range 3840 4608
	depends on SY6970
	---help---
		The voltage the SY6970 charges the cell to, in steps of 16 mV.
		4288 is what the vendor's firmware sets.  A cell rated for 4.20 V
		is charged more gently at 4208, the charger's own default, for a
		few percent less capacity.

config LILYGO_TDECK_MAX_CHARGE_CURRENT
	int "Battery charge current (mA)"
	default 1024
	range 64 5056
	depends on SY6970
	---help---
		The fast charge current, in steps of 64 mA.  1024 is what the
		vendor's firmware sets, about 0.7 C for the 1400 mAh cell.  It is
		applied at every boot because the charger forgets it whenever the
		battery is disconnected.

config LILYGO_TDECK_MAX_BOOT_LORA_POWER
	bool "Power the SX1262 LoRa module at boot"
	default n
	depends on IOEXPANDER_PCA9555
	---help---
		The LoRa rail (XL9555 P01) is left off by default to save power.
		The rail can also be switched at runtime through /dev/lora_en.

config LILYGO_TDECK_MAX_BOOT_GPS_POWER
	bool "Power the MIA-M10Q GPS module at boot"
	default n
	depends on IOEXPANDER_PCA9555
	---help---
		The GPS rail (XL9555 P02) is left off by default to save power.
		The rail can also be switched at runtime through /dev/gps_en.

config LILYGO_TDECK_MAX_BOOT_WIFI
	bool "Bring up Wi-Fi at boot"
	default n
	depends on ESPRESSIF_WIFI
	---help---
		Wi-Fi is left uninitialised by default.  Initialising it takes a
		large part of the internal heap, and the network stack starts the
		radio when it brings wlan0 up, so an idle handheld would otherwise
		keep it running for nothing.

		It can be brought up at runtime instead:

		    gpio -o 1 /dev/wifi_en
		    ifup wlan0

		There is no way to take it down again short of a reset, although
		ifdown and ifup stop and start the radio once it is up.

		Bringing it up at boot needs BOARD_INITTHREAD_STACKSIZE of at
		least 4096.  Anything smaller is refused at build time, because
		the failure is a silent reset loop.

config LILYGO_TDECK_MAX_BOOT_BLE
	bool "Bring up Bluetooth LE at boot"
	default n
	depends on ESPRESSIF_BLE
	---help---
		BLE is left uninitialised by default: bringing it up enables the
		controller, which stays enabled.

		It can be brought up at runtime instead:

		    gpio -o 1 /dev/ble_en
		    ifup bnep0

		There is no way to take it down again short of a reset.

config LILYGO_TDECK_MAX_BOOT_TERMINAL
	bool "Start the on-device terminal at boot"
	default y
	depends on EXAMPLES_NXTERM && SYSTEM_NXINIT
	---help---
		Start nxterm at boot, as an NxInit service, so that the e-paper
		and the keyboard work as a terminal without a computer attached.
		The USB console is unaffected and runs its own shell.

		nxterm's start-up messages are discarded.  If the screen stays
		blank, disable this and run nxterm by hand from the USB console to
		see them.

		The terminal is started once.  Typing exit on the device ends it
		until the next reset: nxterm does not tidy up after its shell, so
		it cannot simply be restarted.

endif # ARCH_BOARD_LILYGO_TDECK_MAX

#include <nuttx/config.h>

/* The common ESP32-S3 init.rc, plus the on-device terminal.  Being first on
 * the board build's VPATH, this file replaces the common one.
 */

/* pnut-os daemons (the pnut-os repository, built as apps/external).  init
 * restarts one that exits.  svcd, the registry, comes first: the others
 * register with it and wait for each other through it.
 */

#ifdef CONFIG_PNUT_SVCD
service svcd svcd
   restart_period 1000
#endif

#ifdef CONFIG_PNUT_CFGD
service cfgd cfgd
   restart_period 1000
#endif

#ifdef CONFIG_PNUT_NOTIFYD
service notifyd notifyd
   restart_period 1000
#endif

#ifdef CONFIG_PNUT_LOGD
service logd logd
   restart_period 1000
#endif

#ifdef CONFIG_PNUT_SYSD
service sysd sysd
   restart_period 1000
#endif

#ifdef CONFIG_PNUT_MODEMD
service modemd modemd
   restart_period 1000
#endif

#ifdef CONFIG_PNUT_MSGD
service msgd msgd
   restart_period 1000
#endif

#ifdef CONFIG_PNUT_DBD
service dbd dbd
   restart_period 1000
#endif

#ifdef CONFIG_PNUT_LORAD
service lorad lorad
   restart_period 1000
#endif

#ifdef CONFIG_PNUT_MESHD
service meshd meshd
   restart_period 1000
#endif

/* pnut-os's user interface, on the e-paper panel */

#ifdef CONFIG_PNUT_SHELL
service shell shell
   restart_period 1000
#endif

#ifdef CONFIG_SYSTEM_NSH
service console sh
   console
   restart_period 1000
#endif

/* adb: with pnut-os, sysd starts and stops it (the setting dev.adb,
 * off unless set)
 */

#if defined(CONFIG_SYSTEM_ADBD) && !defined(CONFIG_PNUT_SYSD)
service adbd adbd
#endif

#ifdef CONFIG_SYSTEM_FASTBOOTD
service fastbootd fastbootd
#endif

#ifdef CONFIG_LILYGO_TDECK_MAX_BOOT_TERMINAL
service terminal nxterm
   console /dev/null
   oneshot
#endif

on init
#ifdef CONFIG_PNUT_SVCD
   start svcd
#endif
#ifdef CONFIG_PNUT_CFGD
   start cfgd
#endif
#ifdef CONFIG_PNUT_NOTIFYD
   start notifyd
#endif
#ifdef CONFIG_PNUT_LOGD
   start logd
#endif
#ifdef CONFIG_PNUT_SYSD
   start sysd
#endif
#ifdef CONFIG_PNUT_MODEMD
   start modemd
#endif
#ifdef CONFIG_PNUT_MSGD
   start msgd
#endif
#ifdef CONFIG_PNUT_DBD
   start dbd
#endif
#ifdef CONFIG_PNUT_LORAD
   start lorad
#endif
#ifdef CONFIG_PNUT_MESHD
   start meshd
#endif
#ifdef CONFIG_PNUT_SHELL
   start shell
#endif
#ifdef CONFIG_SYSTEM_CDCACM
   exec -- sercon
#endif
#ifdef CONFIG_SYSTEM_NSH
   start console
#endif
#if defined(CONFIG_SYSTEM_ADBD) && !defined(CONFIG_PNUT_SYSD)
   start adbd
#endif
#ifdef CONFIG_SYSTEM_FASTBOOTD
   start fastbootd
#endif
#ifdef CONFIG_LILYGO_TDECK_MAX_BOOT_TERMINAL
   start terminal
#endif
